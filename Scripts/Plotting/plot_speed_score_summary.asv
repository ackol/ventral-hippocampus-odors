% plot_speed_score_summary.m - This code is designed to plot two
% histograms, one of the null distribution (produced via circularly
% shuffling the speed vector) and one of the observed speed scores in the
% entire population of units that was recorded
%
%   Inputs:
%       [variable] - ...
%
%   Outputs:
%       ...
%
%   Dependencies:
%       ...
%
% Designed by Anna C. Kolstad
% Author contact email: anna_kolstad@urmc.rochester.edu
% Padmanabhan Lab, University of Rochester School of Medicine
% PI contact email: krishnan_padmanabhan@urmc.rochester.edu
% Script first created: March 12, 2026
% Script last updated: March 12, 2026
% Version 1.0. 

%% PART 1: Load in data

% Load in the pre-consolidated speed score information
[file, path] = uigetfile('*.mat',"Select allSpeedScoreInfo.mat file");
load(fullfile(path,file),"observedSpeedScoresAll", "nullSpeedScoresAll","minimumShiftSec","nShuffles");

% Select directory to save figures
saveFigDir = uigetdir('',"Select destination directory for plotted figures.");

%% PART 2: Plot histograms
disp("Starting PART TWO. Generating null vs. observed speed score histograms.")

speedScoresAll = observedSpeedScoresAll.("Pearson correlation");

upperThreshold = prctile(nullSpeedScoresAll(:),97.5);
lowerThreshold = prctile(nullSpeedScoresAll(:),2.5);

positiveSpeedCellsCount = sum(speedScoresAll>upperThreshold);
negativeSpeedCellCount = sum(speedScoresAll<lowerThreshold);

[nullCounts, nullEdges] = histcounts(nullSpeedScoresAll,'BinMethod','auto');
[observedCounts, observedEdges] = histcounts(nullSpeedScoresAll,'BinMethod','auto');
maxScore = max([max(abs(nullEdges)) max(abs(observedEdges))]);

% NOTE: This figure as written may cut off any edge observed units (since
% the bounds of the x-axis are set based on the null histogram edges, which
% does not take into account the observed data range).
figure('Visible','on');
histogram(nullSpeedScoresAll,nullEdges,'Normalization','probability')
hold on
histogram(speedScoresAll,nullEdges,'Normalization','probability')
xline(upperThreshold,'r--','LineWidth',2)
xline(lowerThreshold,'r--','LineWidth',2)
xlabel("speed scores (r)")
xlim([-maxScore maxScore])
title({"Histogram of null versus observed speed scores", "All mice all units", nShuffles + " shuffles per unit, " + minimumShiftSec + " sec minimum shift"})
legend({'null distribution','observed scores','2.5 and 97.5 %iles of null'},'Location','northwest')
% Save histogram
saveas(gcf, saveFigDir + "\" + "all_mice_speed_score_histogram" + ".png")

disp("Completed PART TWO. Successfully saved null vs. observed histogram for all animals.")

%% PART 3: Plot histogram for CA1 units only
disp("Starting PART THREE. Generating null vs. observed speed score histograms.")

indicesV = observedSpeedScoresAll.("Anatomical Abbreviation")=="vCA1";
indicesI = observedSpeedScoresAll.("Anatomical Abbreviation")=="iCA1";
CA1speedScores = [observedSpeedScoresAll(indicesV,:);observedSpeedScoresAll(indicesI,:)];
CA1speedScoresVector = CA1speedScores.("Pearson correlation");

nullScoresCA1 = [nullSpeedScoresAll(indicesV,:); nullSpeedScoresAll(indicesI,:)];

upperThresholdCA1 = prctile(nullScoresCA1(:),97.5);
lowerThresholdCA1 = prctile(nullScoresCA1(:),2.5);

[nullCounts, nullEdges] = histcounts(nullScoresCA1,'BinMethod','auto');
[observedCounts, observedEdges] = histcounts(CA1speedScoresVector,'BinMethod','auto');
%maxScore = max([max(abs(nullEdges)) max(abs(observedEdges))]);

% NOTE: This figure as written may cut off any edge observed units (since
% the bounds of the x-axis are set based on the null histogram edges, which
% does not take into account the observed data range).
figure('Visible','on');
histogram(nullScoresCA1,nullEdges,'Normalization','probability')
hold on
histogram(CA1speedScoresVector,nullEdges,'Normalization','probability')
xline(upperThreshold,'r--','LineWidth',2)
xline(lowerThreshold,'r--','LineWidth',2)
xline(upperThresholdCA1,'g--','LineWidth',2)
xline(lowerThresholdCA1,'g--','LineWidth',2)
xlabel("speed scores (r)")
xlim([-maxScore maxScore])
title({"Histogram of null versus observed speed scores", "All v&i CA1 units", nShuffles + " shuffles per unit, " + minimumShiftSec + " sec minimum shift"})
legend({'null distribution','observed scores','2.5 and 97.5 %ile of all null',"",'2.5 & 97.5 %ile of CA1 null'},'Location','northwest')
saveas(gcf, saveFigDir + "\" + "CA1_speed_score_histogram" + ".png")

disp("End of script.")

%% PART 4: Plot histogram for CA3 units only
disp("Starting PART FOUR. Generating null vs. observed speed score histograms.")

indicesV = observedSpeedScoresAll.("Anatomical Abbreviation")=="vCA3";
indicesI = observedSpeedScoresAll.("Anatomical Abbreviation")=="iCA3";
CA3speedScores = [observedSpeedScoresAll(indicesV,:);observedSpeedScoresAll(indicesI,:)];
CA3speedScoresVector = CA3speedScores.("Pearson correlation");

nullScoresCA3 = [nullSpeedScoresAll(indicesV,:); nullSpeedScoresAll(indicesI,:)];

upperThresholdCA3 = prctile(nullScoresCA3(:),97.5);
lowerThresholdCA3 = prctile(nullScoresCA3(:),2.5);

[nullCounts, nullEdges] = histcounts(nullScoresCA3,'BinMethod','auto');
[observedCounts, observedEdges] = histcounts(CA3speedScoresVector,'BinMethod','auto');
%maxScore = max([max(abs(nullEdges)) max(abs(observedEdges))]);

% NOTE: This figure as written may cut off any edge observed units (since
% the bounds of the x-axis are set based on the null histogram edges, which
% does not take into account the observed data range).
figure('Visible','on');
histogram(nullScoresCA3,nullEdges,'Normalization','probability')
hold on
histogram(CA3speedScoresVector,nullEdges,'Normalization','probability')
xline(upperThreshold,'r--','LineWidth',2)
xline(lowerThreshold,'r--','LineWidth',2)
xline(upperThresholdCA3,'g--','LineWidth',2)
xline(lowerThresholdCA3,'g--','LineWidth',2)
xlabel("speed scores (r)")
xlim([-maxScore maxScore])
title({"Histogram of null versus observed speed scores", "All v&i CA3 units", nShuffles + " shuffles per unit, " + minimumShiftSec + " sec minimum shift"})
legend({'null distribution','observed scores','2.5 and 97.5 %ile of all null',"",'2.5 & 97.5 %ile of CA3 null'},'Location','northwest')

saveas(gcf, saveFigDir + "\" + "CA3_speed_score_histogram" + ".png")

disp("End of script.")

%% PART 5: Plot histogram for DG units only
disp("Starting PART FIVE. Generating null vs. observed speed score histograms.")

indices = observedSpeedScoresAll.("Anatomical Abbreviation")=="DG";
DGspeedScores = [observedSpeedScoresAll(indices,:)];
DGspeedScoresVector = DGspeedScores.("Pearson correlation");

nullScoresDG = [nullSpeedScoresAll(indices,:)];

upperThresholdDG = prctile(nullScoresDG(:),97.5);
lowerThresholdDG = prctile(nullScoresDG(:),2.5);

[nullCounts, nullEdges] = histcounts(nullScoresDG,'BinMethod','auto');
[observedCounts, observedEdges] = histcounts(DGspeedScoresVector,'BinMethod','auto');
%maxScore = max([max(abs(nullEdges)) max(abs(observedEdges))]);

% NOTE: This figure as written may cut off any edge observed units (since
% the bounds of the x-axis are set based on the null histogram edges, which
% does not take into account the observed data range).
figure('Visible','on');
histogram(nullScoresDG,nullEdges,'Normalization','probability')
hold on
histogram(DGspeedScoresVector,nullEdges,'Normalization','probability')
xline(upperThreshold,'r--','LineWidth',2)
xline(lowerThreshold,'r--','LineWidth',2)
xline(upperThresholdDG,'g--','LineWidth',2)
xline(lowerThresholdDG,'g--','LineWidth',2)
xlabel("speed scores (r)")
xlim([-maxScore maxScore])
title({"Histogram of null versus observed speed scores", "All DG units", nShuffles + " shuffles per unit, " + minimumShiftSec + " sec minimum shift"})
legend({'null distribution','observed scores','2.5 and 97.5 %ile of all null',"",'2.5 & 97.5 %ile of DG null'},'Location','northwest')

saveas(gcf, saveFigDir + "\" + "DG_speed_score_histogram" + ".png")

disp("End of script.")

%% PART 6: Compute a 2-tailed p-value for each unit

nUnits = height(observedSpeedScoresAll);
pVals = nan(nUnits,1);
for iUnit = 1:nUnits
    rObserved = observedSpeedScoresAll.("Pearson correlation")(iUnit);
    % Compute the probability of by chance observing a correlation as 
    % extreme as this unit's
    % pVals(iUnit) = mean(abs(nullSpeedScoresAll(:)) >= abs(rObserved));
    % check : sum(pVals==0) --> if sum >=1, need to use below correction
    % instead:
    % Need to correct the p value to prevent it from becoming exactly 0
    % (this causes problems with FDR) -- basically, pretend there was a
    % single null sample that exceeded this particular observed score
    pVals(iUnit) = (sum(abs(nullSpeedScoresAll(:)) >= abs(rObserved)) + 1) / (numel(nullSpeedScoresAll) +1);
end

% Save p-values to table

alpha = 0.05;
% Sort p values by ascending rank
xVec = 1:1:nUnits;
BHline = alpha/nUnits.*xVec;
BonferroniLine = alpha/nUnits.*ones(1,nUnits);
noCorrectionLine = alpha.*ones(1,nUnits);
[pValsSorted, idx] = sort(pVals);
% Visualized ordered p values
figure()
scatter(xVec, pValsSorted,'filled')
hold on
plot(xVec, BHline)
plot(xVec,BonferroniLine,'--')
plot(xVec, noCorrectionLine,'--')
xlabel("Rank (k)")
ylabel("P-values")
legend({"Obseved","Benjamini-Hockberg cutoff","Bonferroni cutoff","No correction"},'Location','northwest')
hold off
saveas(gcf, saveFigDir + "\" + "ranked_speed_score_p_vals" + ".png")
saveas(gcf, saveFigDir + "\" + "ranked_speed_score_p_vals" + ".fig")

% Apply Storey's method FDR
[FDRStory, q, pi0] = mafdr(pVals,'Showplot',true);
fprintf('Estimated pi0: %.2f\n', pi0);

% Compare Storey with polynomial fit instead
[~, q_poly, pi0_poly] = mafdr(pVals, 'Method', 'polynomial', 'Showplot', true);
fprintf('Spline pi0: %.2f, Polynomial pi0: %.2f\n', pi0, pi0_poly);
% If the above two pi0 values are quite different from one another, then
% better to fall back to the Benjamini-Hochberg method

% Apply Benjamini-Hochberg method to compare
[FDRBH] = mafdr(pVals,'BHFDR',true);

% Classify the neurons
classificationVec = [];
for iUnit = 1:nUnits
    if FDRBH(iUnit) < alpha && speedScoresAll(iUnit) > 0
        classification = "positive speed cell";
    elseif FDRBH(iUnit) < alpha && speedScoresAll(iUnit) < 0
        classification = "negative speed cell";
    else
        classification = "not a speed cell";
    end
    classificationVec = [classificationVec; classification];
end

% Append to a new table
testedSpeedScores = observedSpeedScoresAll;
testedSpeedScores.FDRBH = FDRBH;
testedSpeedScores.Classification = classificationVec;

% Save testedSpeedScores data structure
save(savedirStatisticalTests + "\" + mouseLabel + "_sortedspikes_curated_WSRtestresults", "wilcoxanSignedRankTestPValues","unitInfo",'-v7.3');


%% Plot the fraction of CA1, CA3 and DG cells that are speed cells

indices = testedSpeedScores.("Anatomical Abbreviation")=="DG";
testedSpeedScoresDG = [testedSpeedScores(indices,:)];
notSpeedCellCountDG = sum(strcmp(testedSpeedScoresDG.Classification,"not a speed cell"));
positiveSpeedCellCountDG = sum(strcmp(testedSpeedScoresDG.Classification,"positive speed cell"));
negativeSpeedCellCountDG = sum(strcmp(testedSpeedScoresDG.Classification,"negative speed cell"));
speedCellsDG = [positiveSpeedCellCountDG, negativeSpeedCellCountDG, notSpeedCellCountDG];

indicesV = testedSpeedScores.("Anatomical Abbreviation")=="vCA3";
indicesI = testedSpeedScores.("Anatomical Abbreviation")=="iCA3";
testedSpeedScoresCA3 = [testedSpeedScores(indicesV,:);testedSpeedScores(indicesI,:)];
notSpeedCellCountCA3 = sum(strcmp(testedSpeedScoresCA3.Classification,"not a speed cell"));
positiveSpeedCellCountCA3 = sum(strcmp(testedSpeedScoresCA3.Classification,"positive speed cell"));
negativeSpeedCellCountCA3 = sum(strcmp(testedSpeedScoresCA3.Classification,"negative speed cell"));
speedCellsCA3 = [positiveSpeedCellCountCA3, negativeSpeedCellCountCA3, notSpeedCellCountCA3];

indicesV = testedSpeedScores.("Anatomical Abbreviation")=="vCA1";
indicesI = testedSpeedScores.("Anatomical Abbreviation")=="iCA1";
testedSpeedScoresCA1 = [testedSpeedScores(indicesV,:);testedSpeedScores(indicesI,:)];
notSpeedCellCountCA1 = sum(strcmp(testedSpeedScoresCA1.Classification,"not a speed cell"));
positiveSpeedCellCountCA1 = sum(strcmp(testedSpeedScoresCA1.Classification,"positive speed cell"));
negativeSpeedCellCountCA1 = sum(strcmp(testedSpeedScoresCA1.Classification,"negative speed cell"));
speedCellsCA1 = [positiveSpeedCellCountCA1, negativeSpeedCellCountCA1, notSpeedCellCountCA1];

labels = ["positive speed cells", "negative speed cells", "not speed cells"];
figure();
sgtitle("Prevelance of speed cells detected across regions")
subplot(3,1,1)
piechart(speedCellsDG,labels)
title("DG")
subplot(3,1,2)
piechart(speedCellsCA3,labels)
title("CA3")
subplot(3,1,3)
piechart(speedCellsCA1,labels)
title("CA1")
%legend(regionsOfInterest)
saveas(gcf, saveFigDir + "\" + "prevelance_of_speed_cells_across_regions" + ".png")
saveas(gcf, saveFigDir + "\" + "prevelance_of_speed_cells_across_regions" + ".fig")